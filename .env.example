# ============================================================
# AI Personal Assistant — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.
# ============================================================

# --- Server ---
NODE_ENV="development"
PORT="5001"
CLIENT_URL="http://localhost:5173"

# --- Database ---
# MongoDB Atlas connection string (e.g. mongodb+srv://... or local mongodb://localhost:27017/ai-assistant)
# If left blank during dev/test, an in-memory/fallback database runs automatically
MONGODB_URI=""

# --- Auth / Security ---
# Random long string for signing dashboard JWT sessions
JWT_SECRET=""
# 32-byte (64 hex char) key used to encrypt stored OAuth tokens at rest (AES-256-GCM)
ENCRYPTION_KEY=""

# --- Google (Gmail, Calendar, Tasks) ---
# From Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5001/api/auth/google/callback"

# --- Telegram ---
# Create a bot with @BotFather on Telegram, it gives you this token
TELEGRAM_BOT_TOKEN=""
# A random secret string you choose, used to verify webhook calls really come from Telegram
TELEGRAM_WEBHOOK_SECRET=""

# --- WhatsApp (Meta Business Cloud API) ---
# From Meta for Developers > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
# Alternative if using Twilio instead of Meta directly:
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""

# --- LLM provider ---
# Google Gemini (confirmed default) — get from Google AI Studio, free tier
GEMINI_API_KEY=""
# Optional fallback providers — leave blank unless you add a fallback later
GROQ_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- CRM: HubSpot (confirmed) ---
# HubSpot > Settings > Integrations > Private Apps > create one with
# crm.objects.contacts.read/write scopes, copy the access token here
HUBSPOT_PRIVATE_APP_TOKEN=""

# --- Scheduler ---
# IANA timezone string, default Asia/Amman
DEFAULT_TIMEZONE="Asia/Amman"
MORNING_SUMMARY_TIME="08:00"
EVENING_SUMMARY_TIME="19:00"
